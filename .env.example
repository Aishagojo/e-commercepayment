# Copy this file to .env. Never commit the real .env file.
PORT=3000

# LND connection. Mainnet is the local default; use regtest for free end-to-end tests.
LND_NETWORK=regtest
LND_REST_HOST=localhost
LND_REST_PORT=8081
LND_TLS_PATH=/absolute/path/to/merchant/tls.cert
LND_MACAROON_PATH=/absolute/path/to/merchant/data/chain/bitcoin/regtest/invoice.macaroon
